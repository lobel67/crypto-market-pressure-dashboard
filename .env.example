# Database
MONGODB_URI=mongodb://localhost:27017/crypto-dashboard

# API Keys
BINANCE_API_KEY=your_key_here
BINANCE_SECRET_KEY=your_secret_here
COINGECKO_API_KEY=your_key_here
CRYPTO_COMPARE_KEY=your_key_here
NEWS_API_KEY=your_key_here

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Redis
REDIS_URL=redis://localhost:6379

# WebSocket
WS_PORT=5001

# Data Collection Intervals (in minutes)
MARKET_DATA_INTERVAL=1
LIQUIDATION_INTERVAL=5
WHALE_ALERT_INTERVAL=10
NEWS_FETCH_INTERVAL=30

# Alert thresholds
PRESSURE_SCORE_THRESHOLD=70
LARGE_TRANSACTION_THRESHOLD=500000