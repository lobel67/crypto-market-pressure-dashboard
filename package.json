{
  "name": "crypto-market-pressure-dashboard",
  "version": "1.0.0",
  "description": "Real-time crypto market pressure scoring dashboard with trade analytics",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec ts-node src/backend/server.ts",
    "dev:frontend": "cd client && npm run dev",
    "build": "tsc && cd client && npm run build",
    "start": "node dist/backend/server.js",
    "test": "jest",
    "lint": "eslint src/",
    "collect:market-data": "ts-node src/backend/services/marketDataCollector.ts",
    "calculate:pressure": "ts-node src/backend/services/pressureScoreEngine.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.1.0",
    "mongoose": "^7.5.0",
    "socket.io": "^4.7.1",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.2",
    "redis": "^4.6.11",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.5",
    "eslint": "^8.51.0"
  }
}
